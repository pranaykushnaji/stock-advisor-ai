{
  "ignoreCommand": "node scripts/ignore-data-build.cjs",
  "functions": {
    "api/stock-of-the-day.js": { "maxDuration": 60 },
    "api/capture-open.js": { "maxDuration": 30 },
    "api/refresh-prices.js": { "maxDuration": 60 },
    "api/analyze.js": { "maxDuration": 30 },
    "api/backtest.js": { "maxDuration": 60 },
    "api/premarket.js": { "maxDuration": 60 },
    "api/open-scan.js": { "maxDuration": 60 },
    "api/analytics.js": { "maxDuration": 60 },
    "api/sell-check.js": { "maxDuration": 60 }
  },
  "redirects": [
    { "source": "/", "destination": "/desk/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/legacy", "destination": "/index.html" },
    { "source": "/api/paper-simulation", "destination": "/api/sell-check?monitorMode=simulation" },
    { "source": "/api/minute-monitor", "destination": "/api/sell-check?monitorMode=prices" },
    { "source": "/api/entry-research", "destination": "/api/sell-check?monitorMode=entries" }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/style.css",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
